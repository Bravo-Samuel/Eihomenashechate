{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:bootstrap": "export NODE_ENV=development && tsx src/bootstrap.ts",
    "dev": "export NODE_ENV=development && pkill -TERM -f '[n]ode --enable-source-maps ./dist/index.mjs' 2>/dev/null || true; sleep 0.5 && pnpm run db:bootstrap && (test -f dist/index.mjs && pnpm run start || (pnpm run build && pnpm run start))",
    "dev:rebuild": "export NODE_ENV=development && pnpm run db:bootstrap && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:notifications": "tsx --test src/lib/webNotificationJobs.test.ts",
    "test:security": "tsx --test src/lib/productionReadiness.test.ts src/lib/supabaseAuth.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.9.0",
    "@hebcal/core": "^6.5.3",
    "@supabase/supabase-js": "2.112.4",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/shared-core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.3.0",
    "openai": "^6.42.0",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "razorpay": "^2.9.8",
    "stripe": "^22.2.0",
    "suncalc": "^1.9.0",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/suncalc": "^1.9.2",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
