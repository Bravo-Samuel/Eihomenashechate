{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "qs": "^6.15.2",
      "@babel/core": "^7.29.6",
      "esbuild": "^0.28.1",
      "form-data": "^4.0.6",
      "@types/request>form-data": "^2.5.6",
      "body-parser": "2.3.0",
      "dompurify": "3.4.14",
      "fast-uri": "^3.1.5",
      "image-size": "1.2.1",
      "js-yaml": "^4.3.1",
      "linkify-it": "^5.0.2",
      "markdown-it": "^14.2.0",
      "minimatch": "^9.0.9",
      "postcss": "^8.5.18",
      "protobufjs": "7.6.5",
      "shell-quote": "1.10.0",
      "uuid": "^11.1.1",
      "vite": "^7.3.5",
      "ws": "^8.21.0",
      "tar": "^7.5.21",
      "@expo/cli>undici": "6.28.0",
      "expo-router>nanoid": "3.3.18",
      "razorpay>axios": "1.20.0",
      "express-rate-limit>ip-address": "10.3.1",
      "expo-server-sdk>undici": "7.29.0",
      "@uppy/core>nanoid": "5.1.16",
      "@uppy/dashboard>nanoid": "5.1.16"
    },
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch"
    }
  }
}
